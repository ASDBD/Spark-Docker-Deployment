# Configurazione Ozone tramite variabili d'ambiente.
# L'immagine apache/ozone converte FILE.XML_chiave=valore in <chiave>valore</chiave> dentro FILE.xml
CORE-SITE.XML_fs.defaultFS=ofs://om
CORE-SITE.XML_fs.trash.interval=1
OZONE-SITE.XML_ozone.om.address=om
OZONE-SITE.XML_ozone.om.http-address=om:9874
OZONE-SITE.XML_ozone.scm.names=scm
OZONE-SITE.XML_ozone.scm.client.address=scm
OZONE-SITE.XML_ozone.scm.block.client.address=scm
OZONE-SITE.XML_ozone.scm.http-address=scm:9876
OZONE-SITE.XML_ozone.scm.datanode.id.dir=/data/metadata
OZONE-SITE.XML_ozone.metadata.dirs=/data/metadata
OZONE-SITE.XML_hdds.datanode.dir=/data/hdds
OZONE-SITE.XML_ozone.recon.address=recon:9891
OZONE-SITE.XML_ozone.recon.http-address=0.0.0.0:9888
OZONE-SITE.XML_ozone.recon.db.dir=/data/metadata/recon
# Un solo DataNode -> replica 1 (in produzione: RATIS/THREE)
OZONE-SITE.XML_ozone.server.default.replication=1
OZONE-SITE.XML_ozone.replication=1
OZONE-SITE.XML_ozone.datanode.pipeline.limit=1
OZONE-SITE.XML_ozone.scm.pipeline.owner.container.count=1
# Container e blocchi piccoli: adatti a un laptop
OZONE-SITE.XML_ozone.scm.container.size=256MB
OZONE-SITE.XML_ozone.scm.block.size=16MB
OZONE-SITE.XML_ozone.scm.datanode.ratis.volume.free-space.min=10MB
OZONE-SITE.XML_hdds.datanode.volume.min.free.space=100MB
OZONE-SITE.XML_ozone.scm.pipeline.creation.interval=30s
OZONE-SITE.XML_hdds.heartbeat.interval=5s
OZONE-SITE.XML_ozone.scm.stale.node.interval=30s
OZONE-SITE.XML_ozone.scm.dead.node.interval=45s
OZONE-SITE.XML_hdds.scm.safemode.min.datanode=1
OZONE-SITE.XML_hdds.scm.safemode.healthy.pipeline.pct=0
# S3 Gateway: il bucket "s3" corrisponde al volume /s3v
OZONE-SITE.XML_ozone.s3g.volume.name=s3v
# I bucket creati via S3 usano il layout FILE_SYSTEM_OPTIMIZED (default: OBJECT_STORE),
# così sono accessibili anche da Spark con ofs:// (directory reali, rename atomico)
OZONE-SITE.XML_ozone.s3g.default.bucket.layout=FILE_SYSTEM_OPTIMIZED
OZONE_CONF_DIR=/etc/hadoop
# Heap contenuto per ogni demone Ozone
OZONE_HEAPSIZE_MAX=384m
no_proxy=om,scm,s3g,recon,localhost,127.0.0.1
